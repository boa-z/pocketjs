CONFIG_PRJ_DEFCONFIG_FILENAME="d13x_d50t-2-lite_rt-thread_pocketjs-smoke_defconfig"
CONFIG_PRJ_CHIP="d13x"
CONFIG_PRJ_BOARD="d50t-2-lite"
CONFIG_PRJ_KERNEL="rt-thread"
CONFIG_PRJ_APP="pocketjs-smoke"
CONFIG_AIC_USING_UART0=y
# Gate 1A: give PSRAM_SW a real heap for the PocketJS Rust heap.
#
# The product board baseline (d13x_d50t-2-lite_rt-thread_D50T-2-Lite_defconfig)
# sets this to 0x0, which means AIC_PSRAM_SW_EN is never defined, MEM_PSRAM_SW is
# not an enumerator, and the PSRAM_SW region links to zero bytes. That leaves
# MEM_CMA as the only PSRAM heap - and the PocketJS allocator must not use CMA,
# which is reserved for framebuffer / GE / MPP / DMA.
#
# 8 MiB is a bring-up baseline, not a final budget. The split is re-evaluated
# once Gate 2 framebuffer and later GE/video memory numbers exist. This file is
# the port's own defconfig; the product baseline is deliberately untouched.
# See GATE1A-MEMORY-MAP.md.
CONFIG_AIC_PSRAM_SW_SIZE=0x800000
CONFIG_AIC_PSRAM_SIZE=0x1000000
CONFIG_AIC_INTERRUPTSTACK_SIZE=4096
CONFIG_AIC_CLK_PLL_FRA0_FREQ=792000000
CONFIG_AIC_CLK_PLL_FRA2_FREQ=1188000000
CONFIG_AIC_USING_SID=y
CONFIG_IDLE_THREAD_STACK_SIZE=1024
# CONFIG_RT_KSERVICE_USING_STDLIB is not set
# CONFIG_RT_DEBUG is not set
CONFIG_RT_MEMHEAP_BSET_MODE=y
CONFIG_RT_USING_MEMHEAP_AS_HEAP=y
# CONFIG_RT_USING_MEMHEAP_AUTO_BINDING is not set
CONFIG_RT_CONSOLE_DEVICE_NAME="uart0"
CONFIG_RT_MAIN_THREAD_STACK_SIZE=8192
CONFIG_FINSH_USING_WORD_OPERATION=y
CONFIG_FINSH_USING_FUNC_EXT=y
CONFIG_RT_USING_ULOG=y
CONFIG_ULOG_OUTPUT_LVL_I=y
CONFIG_ULOG_TIME_USING_TIMESTAMP=y
CONFIG_ULOG_USING_FILTER=y
CONFIG_LPKG_USING_CPU_USAGE=y
CONFIG_AIC_ENV_INTERFACE=y
CONFIG_AIC_GPIO_IRQ_DRV_EN=y
CONFIG_AIC_SEC_TEXT_PSRAM=y
CONFIG_AIC_SEC_RODATA_PSRAM=y
CONFIG_AIC_SEC_DATA_PSRAM=y
CONFIG_AIC_SEC_BSS_PSRAM=y
CONFIG_AIC_POCKETJS_SMOKE_APP=y
CONFIG_LPKG_USING_POCKETJS=y
CONFIG_LPKG_POCKETJS_ABI_PROBE=y
CONFIG_LPKG_POCKETJS_AUTORUN=y
