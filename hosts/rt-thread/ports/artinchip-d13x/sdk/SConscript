# Included by the consuming application; no global SDK package hooks.
from building import *
import os
import SCons.Errors

cwd = GetCurrentDir()
port = os.path.dirname(cwd)
host = os.path.dirname(os.path.dirname(port))
repo = os.path.dirname(os.path.dirname(host))
ui = os.path.join(host, 'components', 'pocketjs_ui_core')
libdir = os.path.join(repo, '.pocket-build', 'd13x', 'rust-target',
                      'd13x-e907-ilp32d', 'release')
group = []
runtime_obj = os.path.join(repo, '.pocket-build', 'd13x', 'c-host')
ui_obj = os.path.join(repo, '.pocket-build', 'd13x', 'c-ui')
Env.VariantDir(runtime_obj, os.path.join(port, 'src'), duplicate=0)
Env.VariantDir(ui_obj, os.path.join(ui, 'src'), duplicate=0)

def archive(stem):
    path = os.path.join(libdir, 'lib' + stem + '.a')
    if not os.path.isfile(path):
        raise SCons.Errors.UserError(
            'PocketJS Rust archive missing: ' + path + '\n'
            'Run python application/rt-thread/pocketjs-smoke/build.py first.')
    # File inputs remain tracked dependencies and avoid the SDK LIBS
    # whole-archive wrapper, which duplicates Rust runtime lang items.
    return File(path)

if GetDepend('LPKG_USING_POCKETJS'):
    group += DefineGroup('pocketjs', Glob(os.path.join(runtime_obj, '*.c')),
                         depend=['LPKG_USING_POCKETJS'],
                         CPPPATH=[os.path.join(port, 'include'), os.path.join(port, 'src')])
    group += [archive('pocketjs_abi_probe')]

if GetDepend('LPKG_USING_POCKETJS_UI_CORE'):
    sources = Glob(os.path.join(ui_obj, '*.c'))
    if not GetDepend('LPKG_POCKETJS_UI_CORE_DEMO'):
        sources = [s for s in sources if not str(s).endswith('pocketjs_ui_core_demo.c')]
    group += DefineGroup('pocketjs_ui_core', sources,
                         depend=['LPKG_USING_POCKETJS_UI_CORE'],
                         CPPPATH=[os.path.join(ui, 'include'),
                                  os.path.join(port, 'include'), os.path.join(port, 'src')])
    group += [archive('pocketjs_rtthread_ui_core')]

if GetDepend('LPKG_USING_POCKETJS_RENDER_RGB565'):
    render = os.path.join(host, 'components', 'pocketjs_render_rgb565')
    render_obj = os.path.join(repo, '.pocket-build', 'd13x', 'c-render')
    Env.VariantDir(render_obj, os.path.join(render, 'src'), duplicate=0)
    group += DefineGroup('pocketjs_render_rgb565', Glob(os.path.join(render_obj, '*.c')),
                         depend=['LPKG_USING_POCKETJS_RENDER_RGB565'],
                         CPPPATH=[os.path.join(render, 'include'), os.path.join(ui, 'include')])
    group += [archive('pocketjs_rtthread_render_rgb565')]

if GetDepend('LPKG_USING_POCKETJS_GUEST'):
    qjs = os.path.join(repo, '.pocket-build', 'quickjs')
    if not os.path.isfile(os.path.join(qjs, 'quickjs.c')):
        raise SCons.Errors.UserError('Run PocketJS build.py to prepare pinned QuickJS-ng')
    qobj = os.path.join(repo, '.pocket-build', 'd13x', 'c-quickjs')
    Env.VariantDir(qobj, qjs, duplicate=0)
    group += DefineGroup('pocketjs_quickjs',
        [os.path.join(qobj, f) for f in ('dtoa.c', 'libregexp.c', 'libunicode.c', 'quickjs.c')],
        depend=['LPKG_USING_POCKETJS_GUEST'], CPPPATH=[qjs],
        LOCAL_CPPDEFINES=['PJS_FREESTANDING', 'NDEBUG'], LOCAL_CCFLAGS=' -std=gnu11')
    includes = [qjs, os.path.join(port, 'include'), os.path.join(ui, 'include')]
    for component in ('pocketjs_guest', 'pocketjs_ui_qjs'):
        includes.append(os.path.join(host, 'components', component, 'include'))
    for component in ('pocketjs_guest', 'pocketjs_ui_qjs'):
        src = os.path.join(host, 'components', component, 'src')
        obj = os.path.join(repo, '.pocket-build', 'd13x', component)
        Env.VariantDir(obj, src, duplicate=0)
        group += DefineGroup(component, Glob(os.path.join(obj, '*.c')),
            depend=['LPKG_USING_POCKETJS_GUEST'], CPPPATH=includes, LOCAL_CCFLAGS=' -std=gnu11')

if GetDepend('LPKG_USING_POCKETJS_PACKAGE'):
    package = os.path.join(host, 'components', 'pocketjs_package')
    obj = os.path.join(repo, '.pocket-build', 'd13x', 'c-package')
    Env.VariantDir(obj, os.path.join(package, 'src'), duplicate=0)
    group += DefineGroup('pocketjs_package', Glob(os.path.join(obj, '*.c')),
        depend=['LPKG_USING_POCKETJS_PACKAGE'],
        CPPPATH=[os.path.join(package, 'include')], LOCAL_CCFLAGS=' -std=gnu11')

Return('group')
